simulation
{
  algorithm = "cuda",
  n0 = 1.74d21,
	!  lambda = 800nm
	!  1/w0 = 0.424fs
	!  c/w0 = 127.2nm
}

!----------the node configuration for this simulation---------
node_conf
{
	node_number(1:2) = 2,1,
	if_periodic(1:2) = .false., .false.,
  n_threads = 1,
  tile_number(1:2) = 84,24,
  tile_topology = "snake",
  chunk_size = 5120,
  chunk_pool_size = 100000,
  nchunks_pad = 8,
}

!----------spatial grid----------
grid 
{
	nx_p(1:2) = 1280, 400,
	coordinates = "cartesian",

  load_balance(1:2) = .true., .true.,
  lb_type = "dynamic",
  n_dynamic = 1,
  ! cell_weight = 1.0,
  ! ndump_tile_load = 100,
  ! ndump_node_load = 100,
  ! ndump_global_load = 10,
  ! ndump_tile_node = 100,
  ! ndump_grid_load = 100,
}

!----------time step and global data dump timestep number----------
time_step 
{
  dt=  0.196,
	ndump = 200,  ! ~40
}

!----------restart information----------
restart 
{
  ndump_fac = 0,
  if_restart = .false.,
  if_remold = .true.,
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space 
{
  xmin(1:2) = -256.0,  -200.0,
  xmax(1:2) =    0.0,   200.0,
 	if_move= .true., .false.,
}


!----------time limits ----------
time 
{
  tmin = 0.0, 
	tmax = 3000.0,  
}

!-----------electro-magnetic field------------------
el_mag_fld
{
!	ifextfld = .true.,
!	type_ext_e(2) = "math func",
!	ext_e_mfunc(2) = 'if(x1>0, 5.747d-3/(x1/270.4+1)^2*x2, 0)',      ! start from x1=0 
}

!----------boundary conditions for em-fields ----------
emf_bound 
{
	type(1:2,1) =  "vpml", "vpml",
	type(1:2,2) =  "vpml", "vpml", 
!	type(1:2,3) =  "vpml", "vpml",
}

!----------diagnostic for electromagnetic fields---------- 
diag_emf 
{
  ndump_fac = 1,
	ndump_fac_ave = 1,
	ndump_fac_lineout = 1,
	reports = "e2", "e3",
}

!----------number of particle species----------
particles 
{  
	num_species = 1,
	interpolation = "quadratic",
}

!----------configuratio of the plasma electrons--------------
species
{
	name = "electrons",
	num_par_max = 7000000,
	rqm = -1.0,
 	num_par_x(1:2) = 4, 2,
 	! den_min = 1.d-10,
	add_tag = .false.,
}

udist
{
	uth(1:3) = 0.0, 0.0, 0.0,
	ufl(1:3) = 0.0, 0.0, 0.0,
}
profile
{
	density = 0.9770d-2,   !1.7e19cm-3

	profile_type(1:2) = "piecewise-linear", "uniform",
	num_x = 6,	
	x(1:6,1)  = 0.0, 300.0,  500.0, 1500, 3000.0,  1e6,
	fx(1:6,1) = 0.0,   1.5,    1.5,   1.0,   1.0,  1.0,
}

spe_bound
{
	type(1:2,1) = "open", "open",
	type(1:2,2) = "open", "open",
!	type(1:2,3) = "open", "open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_lineout = 1,
	ndump_fac_ave = 1,
	
	reports = "charge",
	
	ndump_fac_raw = 1,
	raw_fraction = 1,
