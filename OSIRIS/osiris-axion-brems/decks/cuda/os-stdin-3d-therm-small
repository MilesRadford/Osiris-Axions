! small input deck used for developing/testing/debugging

simulation
{
  algorithm = "cuda",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:3) = 1,1,1,
  n_threads = 1,
  if_periodic(1:3) = .true., .true., .true.,
  tile_number(1:3) = 1,1,1,
  tile_topology = "snake",
  chunk_size = 512,
  chunk_pool_size = 5000,
  nchunks_pad = 4,
}

!----------spatial grid----------
grid
{
  nx_p(1:3) = 8,8,8,
  coordinates = "cartesian",
}

!----------time step and global data dump timestep number----------
time_step
{
  dt = .076,
  ndump  = 1,
}

!----------restart information----------
restart
{
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space
{
  xmin(1:3) = 0, 0, 0,
  xmax(1:3) = 1.111,1.111,1.111,
  if_move = .false., .false.,
}


!----------time limits ----------
time
{
  tmin = 0.0,
  tmax = .76,
}

el_mag_fld
{
}

!----------boundary conditions for em-fields ----------
emf_bound
{
}

!----------diagnostic for electromagnetic fields----------
diag_emf
{
  ndump_fac = 1,
  reports = "e1", "e2", "part_e1", "part_e2",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation =  "linear",
  grid_center = .true.,
}

!----------electrons----------
species
{
  name = "electrons",
  num_par_max = 97,
  rqm=-1.0,
  num_par_x(1:3) = 1,1,1,
  n_sort = 0,
  ! free_stream = .true.,
  push_type='standard',
}

udist
{
  uth(1:3) = 0.1 , 0.1 , 0.1,
  ufl(1:3) = 0.0 , 0.0 , 0.0,
}

profile
{
  density = 1,
  profile_type = "uniform",
}

spe_bound
{
}

diag_species
{
  ndump_fac = 1,
  reports = "charge", ! "j1", "j2",
}

current
{
}

diag_current
{
  ! ndump_fac = 1,
  ! reports = "j1", "j2", "j3",
}

smooth
{
}

! --------------------- end of osiris input file ---------------
