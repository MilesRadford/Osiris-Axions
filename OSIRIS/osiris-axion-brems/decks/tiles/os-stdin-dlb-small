! scaled down pwfa simulation for local runs
simulation
{
    n0 = 1.74d21,
  !  lambda = 800nm
  !  1/w0 = 0.424fs
  !  c/w0 = 127.2nm
  algorithm = "tiles",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:2) = 2,1,
  if_periodic(1:2) = .false., .false.,
  tile_number(1:2) = 24,8,
  tile_topology = 'snake',
}

!----------spatial grid----------
grid
{
  ! nx_p(1:2) = 336, 104,
  nx_p(1:2) = 672, 208,
  coordinates = "cartesian",
  load_balance(1:2) = .true., .true.,
  lb_type = "dynamic",
  n_dynamic = 20,
  ! ndump_global_load = 1,
  ! ndump_tile_node = 1,
  ! ndump_node_load = 1,
  ! cell_weight = 0.5,
}

!----------time step and global data dump timestep number----------
time_step
{
  ! dt = 0.744,
  dt = 0.372,
  ndump = 20,
}

!----------restart information----------
restart
{
  ndump_fac = 0,
  if_restart = .false.,
  if_remold = .true.,
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space
{
  xmin(1:2) = -256.0,  -200.0,
  xmax(1:2) =    0.0,   200.0,
  if_move= .true., .false.,
}


!----------time limits ----------
time
{
    tmin = 0.0,
  tmax = 3000.0,
}

!-----------electro-magnetic field------------------
! el_mag_fld
! {
! !  ifextfld = .true.,
! !  type_ext_e(2) = "math func",
! !  ext_e_mfunc(2) = 'if(x1>0, 5.747d-3/(x1/270.4+1)^2*x2, 0)',      ! start from x1=0
! }

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) =  "vpml", "vpml",
  type(1:2,2) =  "vpml", "vpml",
}

!----------diagnostic for electromagnetic fields----------
diag_emf
{
  ndump_fac = 1,
  ndump_fac_ave = 0,
  ndump_fac_lineout = 0,
  reports = "e2", "e3",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation = "linear",
}

!----------configuratio of the plasma electrons--------------
species
{
  name = "electrons",
  num_par_max = 3000,
  rqm = -1.0,
  num_par_x(1:2) = 1, 1,
  add_tag = .false.,
  push_type = "standard",
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}
profile
{
  density = 0.9770d-2,   !1.7e19cm-3
   den_min = 1.d-10,

  profile_type(1:2) = "piecewise-linear", "uniform",
  num_x = 6,
  x(1:6,1)  = 0.0, 300.0,  500.0, 1500, 3000.0,  1e6,
  fx(1:6,1) = 0.0,   1.5,    1.5,   1.0,   1.0,  1.0,
}

spe_bound
{
  type(1:2,1) = "open", "open",
  type(1:2,2) = "open", "open",
!  type(1:2,3) = "open", "open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_lineout = 0,
  ndump_fac_ave = 0,

  reports = "charge",
}

zpulse
{
  a0 = 4.0,
  if_launch = .true.,
  omega0 = 1.0,
  pol_type = 0,
  pol = 0.0,

  propagation = "forward",
  lon_type = "polynomial",
  lon_rise = 76.4552,  ! FWHM_energy = 25 fs
  lon_fall = 76.4552,
  lon_flat = 0,
  lon_start = 1.0,

  per_type = "gaussian",
  per_w0 = 78.74,  ! 10 um
  per_focus = 0.0,
}

current{}

smooth
{
  type = "5pass",
}

! --------------------- end of osiris input file ---------------
