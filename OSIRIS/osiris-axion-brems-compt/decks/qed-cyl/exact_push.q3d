simulation
{
  algorithm = "qed-q3d",
  omega_p0 = 1.8836e15, ! we normalise to the laser wavelength = 1.0 microns
}

node_conf
{
  node_number(1:2) =  2, 2,
  if_periodic(1:2) = .false., .false.,
}


!----------spatial grid----------
grid
{
  nx_p(1:2) = 400, 200,
  coordinates = "cylindrical",
  n_cyl_modes = 1,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt =  0.021,
  ndump =  60,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:2) = -8.0,  0.0,
  xmax(1:2) =  8.0,  8.0,
  if_move(1:2) = .false., .false.,
}

!----------time limits ----------
time
{
  tmin =  0.00,
  tmax = 12.60,
}

el_mag_fld
{
  ext_fld = "static",
  type_ext_b(1:3) = "uniform", "uniform", "uniform",
  ext_b0_re(0,1:3) = 4.528d2, 0.0, 0.0,
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) = "lindman","lindman",
  type(1:2,2) = "axial","open",
}

!----------emf diagnostics----------
diag_emf{
  ndump_fac = 1,
  ndump_fac_ave = 1,
  ndump_fac_ene_int = 1,
  reports = "e1_cyl_m","e2_cyl_m","e3_cyl_m","b1_cyl_m","b2_cyl_m","b3_cyl_m",
            "ext_b1_cyl_m",
}

!----------number of particle species----------
particles
{
  num_qed = 1,
  interpolation = "cubic",
}

!----------qed group, setting photon and pair creation----------
qed_group
{
  if_damp_classical = .true.,
  if_damp_qed = .true.,
  if_pairprod = .true.,
  qed_g_cutoff =    0.,
  p_emit_cutoff =   2.,
}

!----------qed group, setting diagnostics----------
qed_group_diag
{
  ndump_fac_rad = 1,
  ndump_fac_pairs = 1,

  ndump_fac_radspect = 1,
  radspect_emin = 1.0e-5,
  radspect_emax = 1.0e+2,
  radspect_bins = 200,
}

!----------information for electrons----------

species
{
  name = "electrons",
  num_par_x(1:2) = 2, 2,
  num_par_max = 1000000,
  rqm= -1.0,
  push_type="exact",
  rad_react = .true.,
  iter_tol = 1.0d-3,
  q_real = -1.0,
  add_tag = .true.,
  num_par_theta = 8,
}

udist
{
  uth(1:3) = 0.0, 0.0,     0.0,
  ufl(1:3) = 0.0, 0.0, 9.055d2,
}

profile
{
  density = 1.0d-3,
  profile_type(1) = "math func",
  math_func_expr = "if( abs(x2-2.0) < 0.04 , if( abs(x1)<0.5, 1.0 , 0.0 ) , 0.0 )"
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "axial","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports = "charge_cyl_m",

  ! For xc2 and xc3 phasespaces, which are cartesian x2 and x3
  ps_xcmin(1:3) = -2.0, -60.0, -60.0,
  ps_xcmax(1:3) =  2.0,  60.0,  60.0,
  ps_nxc(1:3)   =   200,   200,   200,

  ps_xmin(1:2) = -2.0,   0.0,
  ps_xmax(1:2) =  2.0,  60.0,
  ps_nx(1:2)   =  200,   200,

  ps_pmin(1:3) = -2000.0, -2000.0, -2000.0,
  ps_pmax(1:3) =  2000.0,  2000.0,  2000.0,
  ps_np(1:3)   =     200,     200,     200,

  ps_ngamma =  10000,
  ps_gammamin =  1.0,
  ps_gammamax = 2000.0,

  phasespaces = "p3p2", "xc3xc2x1", "xc2x1", "g", "p1x1",

  raw_fraction = 1.0,

}

!----------information for positrons----------

species
{
  name = "positrons",
  num_par_x(1:2) = 10, 10,
  num_par_max = 1000000,
  rqm= 1.0,
  push_type="standard",
  add_tag = .true.,
  num_par_theta = 8,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "axial","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports = "charge_cyl_m",

  ! For xc2 and xc3 phasespaces, which are cartesian x2 and x3
  ps_xcmin(1:3) = -2.0, -60.0, -60.0,
  ps_xcmax(1:3) =  2.0,  60.0,  60.0,
  ps_nxc(1:3)   =   200,   200,   200,

  ps_xmin(1:2) = -2.0,   0.0,
  ps_xmax(1:2) =  2.0,  60.0,
  ps_nx(1:2)   =  200,   200,

  ps_pmin(1:3) = -2000.0, -2000.0, -2000.0,
  ps_pmax(1:3) =  2000.0,  2000.0,  2000.0,
  ps_np(1:3)   =     200,     200,     200,

  ps_ngamma =  10000,
  ps_gammamin =  1.0,
  ps_gammamax = 2000.0,

  phasespaces = "p3p2", "xc3xc2x1", "xc2x1", "g", "p1x1",

  raw_fraction = 0.01,
}

!----------information for photons----------

species
{
  name = "photons",
  num_par_x(1:2) = 2, 2,
  num_par_max = 1000000,
  rqm= 1.0,
  push_type="standard",
  add_tag = .true.,
  num_par_theta = 8,
}

udist
{
  uth(1:3) =    0.0,    0.0,    0.0,
  ufl(1:3) =    0.0,    0.0,    0.0,
}

profile
{
  density = 0.0d0,
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "axial","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports = "charge_cyl_m",

  ! For xc2 and xc3 phasespaces, which are cartesian x2 and x3
  ps_xcmin(1:3) = -2.0, -60.0, -60.0,
  ps_xcmax(1:3) =  2.0,  60.0,  60.0,
  ps_nxc(1:3)   =   200,   200,   200,

  ps_pmin(1:3) = -2000.0, -2000.0, -2000.0,
  ps_pmax(1:3) =  2000.0,  2000.0,  2000.0,
  ps_np(1:3)   =     200,     200,     200,

  ps_ngamma =  10000,
  ps_gammamin =  1.0,
  ps_gammamax = 2000.0,

  ps_ngamma =  10000,
  ps_gammamin =  1.0,
  ps_gammamax = 60.0,

  phasespaces = "p3p2", "xc3xc2x1", "xc2x1", "g", "p1x1",

  raw_fraction = 0.01,
}

! --------------------- end of osiris input file ---------------
