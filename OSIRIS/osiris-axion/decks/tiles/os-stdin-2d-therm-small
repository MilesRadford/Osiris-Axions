simulation
{
  algorithm = "tiles",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:2) = 1,1,
  n_threads = 1,
  tile_number(1:2) = 16, 16,
  if_periodic(1:2) = .true., .true.,
  tile_topology = "hilbert",
}

!----------spatial grid----------
grid
{
  nx_p(1:2) = 128, 128,
  coordinates = "cartesian",
  ! load_balance(1:2) = .true., .true.,
