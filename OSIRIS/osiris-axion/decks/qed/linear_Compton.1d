
! ----- Simulation parameters -----
simulation{
	omega_p0 = 1.0e20,
	algorithm = "qed",
}

! ----- Node Configuration -----
node_conf{
	node_number(1) = 1,
	if_periodic(1) = .true.,
}

! ----- Spatial grid -----
grid{
	nx_p(1) = 4096,
	coordinates = "cartesian",
}

! ----- Time step -----
time_step{
	dt = 0.1,
	ndump = 2,
}

! ----- Space settings -----
space{
	xmin(1) = 0,
	xmax(1) = 4096,
}

! ----- Time settings
time{
	tmin = 0.0,
	tmax = 0.2,
}

! ----- Boundaries for EM field -----
emf_bound{
	type(1:2,1) = "open","open",
}

! ----- Species -----
particles{
	num_qed = 1,
	interpolation = "quadratic",
}

!----------qed group, setting photon and pair creation----------
qed_group{
  if_damp_classical = .false.,
  if_damp_qed = .false.,
  if_pairprod = .false.,
  qed_g_cutoff = 1.0e20,
  p_emit_cutoff = 1.0e20,
}

! -----
! ELECTRONS
! -----
species{
	name = "electrons",
	num_par_max = 8000000,
	num_par_x(1) = 4096,
	rqm = -1.0,
	add_tag = .true.,
	q_real = -1.0,
	free_stream = .true.,
}

! ----- Momentum distribution -----
udist{
	ufl(1:3) = 100.0, 0.0, 0.0,
}

! ----- Density profile -----
profile{
	density = 1.0e3,
	profile_type = "uniform",
}

! ----- Boundary conditions -----
spe_bound{
	type(1:2,1) = "open", "open",
}

! -----
! POSITRONS
! -----
species{
	name = "positrons",
	num_par_max = 100,
	num_par_x(1) = 2,
	rqm = +1.0,
	add_tag = .true.,
	q_real = +1.0,
}

! ----- Momentum distribution -----
udist{
	ufl(1:3) = 0.0, 0.0, 0.0,
}

! ----- Density profile -----
profile{
	density = 0.0,
	profile_type(1) = "uniform",
}

! ----- Boundary conditions -----
spe_bound{
	type(1:2,1) = "open", "open",
}

! ----- Diagnostic -----
diag_species{
	ndump_fac = 0,
	ndump_fac_ene = 1,
	ndump_fac_raw = 0,
	reports = "charge",
	raw_fraction = 1,
}

! -----
! PHOTONS
! -----
species{
	name = 'photons',
	num_par_max = 8000000,
	num_par_x(1) = 4096,
	add_tag = .true.,
}

! ----- Momentum distribution -----
udist{
	uth_type = "random dir",
	uth(1) = 0.025, uth(2) = 0.0, uth(3) = 0.0,
}

! ----- Density profile -----
profile{
	density = 1.0e3,
	profile_type = "uniform",
}

! ----- Boundary conditions -----
spe_bound{
	type(1:2,1) = "open", "open",
}

! ----- Diagnostic -----
diag_species{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	ndump_fac_raw = 1,
	raw_fraction = 1.0,
}

! ----- QED Collisions -----
qed_collide_info{
	if_qed_collide = .true.,
	if_recoil = .false.,
	if_split = .true.,
	npc_per_ccell(1) = 1, ! set to the whole simulation box to neglect the spatial binning
}
