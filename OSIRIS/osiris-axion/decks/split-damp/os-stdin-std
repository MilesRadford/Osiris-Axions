!---------------------------------------------
!Input-deck to simulate quasi-1D overdense plasma
!author: Kyle Miler
!date: 9/20/21
!
!Physical parameters
!electrons/ions are 100 eV
!ions are fully ionized carbon (6q, 12m), with rqm=3672.3054
!Density profile exponential L=3um between 0.01ncrit and 10ncrit, then constant
!Laser wavelength = 1um
!n_crit = 1.11698x10^21cm-3
!a0 = 3.0
!c/wp = 0.159155 um
!1/wp = 0.530516 fs
!---------------------------------------------
simulation{
  algorithm = "split-damp",
}
!---------------------------------------------
node_conf{
  node_number(1:2)=8,1,
  n_threads = 1,
  if_periodic(1:2)=.false.,.true.,
}
!---------------------------------------------
grid{
  nx_p(1:2) = 2500, 25,
  load_balance(1:2) = .true.,.false.,
  lb_type = "dynamic",
  n_dynamic = 50,
  cell_weight = 1.0,
}
!---------------------------------------------
time_step{
  dt=0.141,
  ndump=400,
}
!---------------------------------------------
restart{
  ndump_fac=1,
  if_restart=.false.,
  if_remold=.true.,
}
!---------------------------------------------
space{
  xmin(1:2)=-300.0, -2.5,
  xmax(1:2)= 200.0,  2.5,
  if_move(1:2)= .false.,.false.,
}
!---------------------------------------------
time{
  tmin=0.0,
  tmax=1600.0,
}
!---------------------------------------------
el_mag_fld{
}
!---------------------------------------------
emf_bound{
  type(1:2,1)="open", "open",
  vpml_diffuse(1:2,1)= .false., .true.,
}
!---------------------------------------------
diag_emf{
  ndump_fac=1,
  reports="e1","e2","e3",
}
!---------------------------------------------
particles{
  num_species=2,
  interpolation="cubic",
  ndump_fac_ene = 1,
}
!---------------------------------------------
species{
  name="electrons",
  num_par_max=1500000,
  rqm=-1.0,
  num_par_x(1:2)=4,4,
  push_start_time=100.0,
}
!---------------------------------------------
udist{
  uth(1:3)=0.0139891, 0.0139891, 0.0139891,
  ufl(1:3)=0.0,0.0,0.0,
}
!---------------------------------------------
profile{
  profile_type="math func",
  math_func_expr = "if(x1 >= (-173.611), if(x1 >= 0.0, 10.0, 10.0*exp(0.0530516*x1)), 0.0)",
  density=1.0,
  den_min=1.d-12,
}
!---------------------------------------------
spe_bound{
  type(1:2,1)="absorbing", "thermal",
  uth_bnd(1:3,2,1) = 0.0139891, 0.0139891, 0.0139891,
}
!---------------------------------------------
diag_species{
  ndump_fac=1,
  reports="charge",

  ndump_fac_pha=1,
  ps_nx(1:2)=500,25,
  ps_pmin(1:3)=-10.0,-12.0,-0.11,
  ps_pmax(1:3)=20.0,12.0,0.11,
  ps_np(1:3)=400,200,100,
  if_ps_p_auto(1:3)=.true.,.true.,.true.,
  ps_gammamin=1.0,
  ps_gammamax=100.0,
  ps_ngamma=400,
  if_ps_gamma_auto=.false.,
  phasespaces="p1x1","p2x1","p2p1","glx1_q1","x1_j1","x1_q1","x1_ene","x1_j2","x2x1_j1",
              "x2x1_j2",
}
!---------------------------------------------
damper{
  n_damp = 3,
  damper_direction = 1,
  orientation = "forward",
  damp_start_time = 400.0,

  ! specify the mean free path of stopping
  ! the absorbing region will be 3*mfp long and located against the boundary
  ! (right boundary if orientation is "forward", left boundary if "backward")
  mfp = 31.623, ! 100 c/wp = 100/sqrt(10) c/w0

  ! default vth_mult_* values are 6, but user can specify whatever
  ! vth_mult_start = 10.,
  ! vth_mult_full = 3.,
}
!---------------------------------------------
splitting
{
  n_split = 10,
  ! density at which we consider a particle to be unsplit
  unsplit_charge_density = 10.0,
  splitting_gammas(1:5) = 1.4, 1.5, 1.6, 1.7, 1.8,

  if_recombine = .true.,
  n_recombine = 10,
  recombine_start_time = 400.0,
  n_recombine_regions = 1,
  ! usually the same location where the damper begins (3*mfp from the boundary)
  recomb_box_bounds(1,1:2,1) = 105.131, 200.0,
  recomb_box_bounds(2,1:2,1) = -2.5, 2.5,
  recomb_cell_dx(1:2,1) = 0.4, 0.4,
}
!---------------------------------------------
species{
  name="ions",
  num_par_max=100000,
  rqm=3672.3054,
  num_par_x(1:2)=2,2,
  push_start_time=100.0,
}
!---------------------------------------------
udist{
  uth(1:3)=0.000230845, 0.000230845, 0.000230845,
  ufl(1:3)=0.0,0.0,0.0,
}
!---------------------------------------------
profile{
  profile_type="math func",
  math_func_expr = "if(x1 >= (-173.611), if(x1 >= 0.0, 10.0, 10.0*exp(0.0530516*x1)), 0.0)",
  density=1.0,
  den_min=1.d-12,
}
!---------------------------------------------
spe_bound{
  type(1:2,1)="absorbing", "thermal",
  uth_bnd(1:3,2,1) = 0.000230845, 0.000230845, 0.000230845,
}
!---------------------------------------------
diag_species{
  ndump_fac_pha=1,
  ps_nx(1:2)=400,25,
  ps_pmin(1:3)=-0.01,-0.001,-0.001,
  ps_pmax(1:3)=0.01,0.001,0.001,
  ps_np(1:3)=200,200,100,
  if_ps_p_auto(1:3)=.true.,.true.,.true.,
  ps_gammamin=1.0,
  ps_gammamax=1.2,
  ps_ngamma=200,
  if_ps_gamma_auto=.true.,
  phasespaces="p1x1","p2x1","p2p1","glx1_q1","x1","x1_j1","x1_q1","x1_ene","x1_j2",
              "x2x1_j1","x2x1_j2",
}
!---------------------------------------------
damper{
  n_damp = 3,
  damper_direction = 1,
  orientation = "forward",
  damp_start_time = 400.0,

  ! specify the mean free path of stopping
  ! the absorbing region will be 3*mfp long and located against the boundary
  ! (right boundary if orientation is "forward", left boundary if "backward")
  mfp = 31.623, ! 100 c/wp = 100/sqrt(10) c/w0

  ! default vth_mult_* values are 6, but user can specify whatever
  ! vth_mult_start = 10.,
  ! vth_mult_full = 3.,
}
!---------------------------------------------
smooth{
  type="5pass",
}

!---------------------------------------------
!LASER----------------------------------------
!---------------------------------------------
antenna_array { n_antenna = 1, }

antenna
{
  a0 = 3.0,
  t_rise = 50.0,
  t_flat = 1000.0,
  t_fall = 50.0,
  omega0 = 1.0,
  pol = 0.0,
  x0 = 0.0,
  rad_x = 100000.0,
}
