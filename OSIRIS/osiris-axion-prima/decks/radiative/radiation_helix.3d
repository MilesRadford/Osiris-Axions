simulation
{
  algorithm="radiative",
}

node_conf
{
  node_number(1:3) =  1,1,1,
  if_periodic(1:3) =  .false., .false., .false.,
}

!----------spatial grid----------
grid
{
  nx_p(1:3) =  200, 16, 16,
  coordinates = "cartesian",
}

!----------time step and global data dump timestep number----------
time_step
{
  dt     =   0.0104d0,
  ndump  =    1,
}

!----------restart information----------
restart
{
  ndump_fac = 0,
  if_restart=.false.,
  if_remold=.true.,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:3) =  10.000d0, -0.8000d0, -0.800d0,
  xmax(1:3) =  30.000d0, 0.8000d0, 0.800d0,
  if_move(1:3) = .true., .false., .false.,
}

!----------time limits ----------
time
{
  tmin = 0.0d0, tmax  =40.2d0,
}

!----------field solver set up----------
el_mag_fld
{
  ext_fld = "static",
  ext_b0(1:3)=1.5d0,0.0d0,0.0d0,
  ext_e0(1:3)=0.0d0,
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) =   "open", "open",
  type(1:2,2) =   "open", "open",
  type(1:2,3) =   "open", "open",
}

!----------number of particle species----------
particles
{
  interpolation = "linear",
  ! num_species = 1,
  num_radiat =1,
}

!----------information for species 1----------
species
{
  num_par_max = 2000,
  rqm=-1.0,
  num_par_x(1:3) = 1, 1, 1,
  q_real=-1.,
  add_tag = .true.,
}

!----------inital proper velocities-----------------
udist {
  uth_type="waterbag",
  uth(1:3) = 0.0d0 , 0.1d0 , 0.0d0 ,
  ufl(1:3) = 0.9999d0 , 0.0d0 , 0.0d0 ,
}

!----------density profile for this species----------
profile
{
  profile_type="sphere",
  sphere_center(1:3)=28.2,0.005,0.0,
  sphere_radius=0.5,
  density=40,
}

!----------boundary conditions for this species----------
spe_bound
{
  type(1:2,1) =   "open", "open",
  type(1:2,2) =   "open", "open",
  type(1:2,3) =   "open", "open",
}

!----------diagnostic for this species----------
diag_species
{
  ndump_fac_raw = 10,
  ! raw_gamma_limit = 0.,
  ! file_tags = "species 123.tags",
  ! ndump_fac_tracks=10,
  ! niter_tracks=1,
}

! optional section
! selection
! {
!   rad_tags=.True.,
!   rad_file_tags="species 1_.tags",
! }

spherical
{
  ! number of cells in each direction (time, theta, phi, r)
  nf(:) = 4096,1,1024,1,
  ! range of the detector
  dmin(:)=-30.5,1.57078,-0.1,100000,
  dmax(:)=10.5,1.67,0.1,100001,
  ! far-far-field approximation
  approx=.True.,
  ! Output field components
  comps(:)=.False.,.True.,.True.,.False.,.False.,.False.,
  ndump_fac_det=900,
}

!----------smoothing for currents----------
smooth
{
  type = "5pass",
}
