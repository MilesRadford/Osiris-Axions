simulation
{
  algorithm = "quasi-3D",
}

node_conf
{
  node_number(1:2) =  1,1,
  if_periodic(1:2) = .false., .false.,
}


!----------spatial grid----------
grid
{
  nx_p(1:2) = 200, 50,
  coordinates = "cylindrical",
  n_cyl_modes = 1,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt     =   0.07,
  ndump  =   1,
}

restart
{
  ndump_fac = 0,
  if_restart=.false.,
  if_remold=.true.,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:2) =     0.0,  0.0,
  xmax(1:2) =   100.0, 10.0,
  if_move(1:2) = .false., .false.,
}


!----------time limits ----------
time
{
  tmin = 0.0,
  tmax  = 7.0,
}

el_mag_fld
{
  ext_fld = "static",
  type_ext_b(1:3) = "uniform", "uniform", "uniform",

  ! b ext pointing in x hat direction
  ! ext_b0_re(1,1:3) = 0.0, 1.0, 0.0,
  ! ext_b0_im(1,1:3) = 0.0, 0.0, -1.0,

  ! b ext pointing in y hat direction
  ! ext_b0_re(1,1:3) = 0.0, 0.0, 1.0,
  ! ext_b0_im(1,1:3) = 0.0, 1.0, 0.0,

  ! b ext pointing in z hat direction
  ext_b0_re(0,1:3) = 1.0, 0.0, 0.0,

  ! You can also use math functions to specify fields for each mode/component
  ! type_ext_b(1:3) = "math func", "none", "none",
  ! ext_b_re_mfunc(0,1) = "x1",
  ! ext_b_re_mfunc(1,1) = "x1^2",
  ! ext_b_im_mfunc(1,1) = "x2",
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) = "lindman", "lindman",
  type(1:2,2) = "axial", "vpml",
  vpml_bnd_size = 30,
  vpml_diffuse(1:2,2) = .false., .true.,
}

diag_emf
{
  ndump_fac = 10,
  reports = "b1_cyl_m     ", "b2_cyl_m     ", "b3_cyl_m     ",
            "ext_b1_cyl_m ", "ext_b2_cyl_m ", "ext_b3_cyl_m ",
            "part_b1_cyl_m", "part_b2_cyl_m", "part_b3_cyl_m",
            "e1_cyl_m     ", "e2_cyl_m     ", "e3_cyl_m     ",
            "ext_e1_cyl_m ", "ext_e2_cyl_m ", "ext_e3_cyl_m ",
            "part_e1_cyl_m", "part_e2_cyl_m", "part_e3_cyl_m",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation = "quadratic",
}

!----------information for species 1----------
species
{
  name = "positrons",
  num_par_x(1:2) = 1, 3,
  num_par_theta = 8,
  num_par_max = 100000,
  rqm= 1.0,
}

udist
{
  uth(1:3) =  0.01, 0.01, 0.01,
  ufl(1:3) =  0.0, 0.0, 0.0,
}

profile
{
  density = 1.0,
}

spe_bound
{
  type(1:2,1) = "open", "open",
  type(1:2,2) = "axial", "open",
}
