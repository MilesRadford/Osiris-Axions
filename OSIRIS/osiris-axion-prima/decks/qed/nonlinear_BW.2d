simulation
{
  algorithm = 'qed',
  omega_p0 = 1.88e15,
}

node_conf
{
  node_number(1:2) =  2, 2,
  if_periodic(1:2) = .true., .true.,
}


!----------spatial grid----------
grid
{
  nx_p(1:2) = 200, 200,
  coordinates = "cartesian",
}

!----------time step and global data dump timestep number----------
time_step
{
  dt =  0.02,
  ndump =  1,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:2) = -4.0, -4.0,
  xmax(1:2) =  4.0,  4.0,
  if_move(1:2) = .false., .false.,
}

!----------time limits ----------
time
{
  tmin =  0.00,
  tmax =  0.01,
}

el_mag_fld
{
  ext_fld = "static",
  type_ext_b(1:3) = "uniform", "uniform", "uniform",
  ext_b0(1:3) = 1.05e3, 0.0, 0.0,
}

!----------boundary conditions for em-fields ----------
emf_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

!----------emf diagnostics----------
diag_emf{
  ndump_fac = 1,
  ndump_fac_ene_int = 1,
  reports = "ext_b1", 
}

!----------number of particle species----------
particles
{
  num_qed = 1,
  interpolation = "cubic",
}

!----------qed group, setting photon and pair creation----------
qed_group
{
  if_damp_classical = .false.,
  if_damp_qed = .false.,
  if_pairprod = .true.,
  qed_g_cutoff =  1.e10,
  p_emit_cutoff = 1.e10,
}

!----------qed group, setting diagnostics----------
qed_group_diag
{
  ndump_fac_rad = 1,
  ndump_fac_pairs = 1,
  ndump_fac_radspect = 1,
  ndump_fac_chi_emit = 1,
}

!----------information for electrons----------

species
{
  name = "electrons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 1000000,
  rqm = -1.0,
  push_type = "standard",
  add_tag = .true.,
  free_stream = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

!----------information for positrons----------

species
{
  name = "positrons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 1000000,
  rqm = 1.0,
  push_type = "standard",
  add_tag = .true.,
  free_stream = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

!----------information for photons----------

species
{
  name = "photons",
  num_par_x(1:2) = 20, 20,
  num_par_max = 4000000,
  rqm = 0.0,
  push_type = "standard",
  add_tag = .true.,
!  push_start_time = 0.01,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 1957.,
}

profile
{
  density = 1.0d-6,
}

spe_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

! --------------------- end of osiris input file ---------------
