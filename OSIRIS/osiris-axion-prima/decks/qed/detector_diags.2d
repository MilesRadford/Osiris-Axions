simulation
{
  algorithm = "qed",
  omega_p0 = 1.8836e15, ! we normalise to the laser wavelength = 1.0 microns
}

node_conf
{
  node_number(1:2) = 2, 2,
  if_periodic(1:2) = .true., .true.,
}

grid
{
  nx_p(1:2) =  50, 50,
  coordinates = "cartesian",
}

time_step
{
  dt     =  0.001,
  ndump  =  100,
}

space
{
  xmin(1:2) =  0.0, 0.0,
  xmax(1:2) =  2.0, 2.0,
  if_move(1:2) = .false., .false.,
}

time
{
  tmin =  0.0,
  tmax = 10.0,
}

el_mag_fld
{
  ext_fld = "dynamic",

  type_ext_b(1:3) = "math func", "math func", "math func",
  ext_b_mfunc(1) = "200d0*cos(t)*sin(t/20.0)*sin(t/20.0)",
  ext_b_mfunc(2) = "200d0*sin(t)*sin(t/20.0)*sin(t/20.0)",
  ext_b_mfunc(3) = "0d0",

  type_ext_e(1:3) = "math func", "math func", "math func",
  ext_e_mfunc(1) =  "-200d0*sin(t)*sin(t/20.0)*sin(t/20.0)",
  ext_e_mfunc(2) = "200d0*cos(t)*sin(t/20.0)*sin(t/20.0)",
  ext_e_mfunc(3) = "0d0",
}


emf_bound
{
  type(1:2,1) =   "open", "open",
  type(1:2,2) =   "open", "open",
}

diag_emf
{
  ndump_fac = 1,
  ndump_fac_ene_int = 1,
  reports = "b1", "b2", "b3", "e1", "e2", "e3",
            "ext_b1", "ext_b2", "ext_b3", "ext_e1", "ext_e2", "ext_e3",
}


particles
{
  num_species = 0,
  num_qed = 1,
}

qed_group
{
  if_damp_classical = .true.,
  if_damp_qed = .true.,
  if_pairprod = .false.,

  qed_g_cutoff = 200.0,
  p_emit_cutoff = 2.0,
}

qed_group_diag
{
  ndump_fac_rad = 1,
  ndump_fac_pairs = 1,

  ndump_fac_raddetector = 20,
  raddetector_nbins = 200,
  raddetector_phimin = -0.2,
  raddetector_phimax = 0.2,
  raddetector_thetamin = -0.2,
  raddetector_thetamax = 0.2,
  detector_direction = "x3_positive",

  ndump_fac_radsphere = 20,
  radsphere_nbins = 200,
  if_add_classical_radsphere = .false.,

}

species
{
  name = "electrons",
  num_par_max = 200000,
  rqm = -1.0,
  num_par_x(1:2) = 2, 2,
  push_type="standard",
}

udist
{
  ufl(1:3) = 0.d0, 0.0d0, 1000.0d0,
  uth(1:3) = 20.d0, 20.0d0, 20.0d0,
  use_classical_uadd = .true.,
}

profile
{
  density = 1.0,
}

spe_bound
{
  type(1:2,1) =   "open", "open",
  type(1:2,2) =   "open", "open",
}

diag_species
{
  ndump_fac = 1,
  reports = "charge",

  ndump_fac_ene = 1,
  ndump_fac_pha = 1,
  ndump_fac_raw = 10,

  ps_xmin(1:2) = 0.0, 0.0,
  ps_xmax(1:2) = 2.0, 2.0,
  ps_nx(1:2)   =  50,  50,

  ps_pmin(1:3) = -1.0, -1.0, -1.0,
  ps_pmax(1:3) =  1.0,  1.0,  1.0,
  ps_np(1:3)   = 2048,  2048,  2048,
  if_ps_p_auto(1:3) = .true., .true., .true.,

  ps_gammamin = 1.0,
  ps_gammamax = 2.0,
  ps_ngamma = 512,
  if_ps_gamma_auto = .true.,

  phasespaces = "p2x1", "p1x1", "p2x2", "p1x2",

  raw_fraction = 1.0,
}

species
{
  name = "positrons",
  num_par_max = 200000,
  rqm = 1.0,
  num_par_x(1:2) = 2, 2,
  push_type="standard",
}

udist
{
  ufl(1:3) = 0.d0, 0.0d0, 0.0d0,
  uth(1:3) = 0.d0, 0.0d0, 0.0d0,
}

profile
{
  density = 0.0,
}

spe_bound
{
  type(1:2,1) =   "open", "open",
  type(1:2,2) =   "open", "open",
}

diag_species
{
  ndump_fac = 1,
  reports = "charge",

  ndump_fac_ene = 1,
  ndump_fac_pha = 1,
  ndump_fac_raw = 10,

  ps_xmin(1:2) = 0.0, 0.0,
  ps_xmax(1:2) = 2.0, 2.0,
  ps_nx(1:2)   =  50,  50,

  ps_pmin(1:3) = -1.0, -1.0, -1.0,
  ps_pmax(1:3) =  1.0,  1.0,  1.0,
  ps_np(1:3)   = 2048,  2048,  2048,
  if_ps_p_auto(1:3) = .true., .true., .true.,

  ps_gammamin = 1.0,
  ps_gammamax = 2.0,
  ps_ngamma = 512,
  if_ps_gamma_auto = .true.,

  phasespaces = "p2x1", "p1x1", "p2x2", "p1x2",

  raw_fraction = 1.0,
}

species
{
  name = "photons",
  num_par_max = 200000,
  num_par_x(1:2) = 2, 2,
  push_type="standard",
}

udist
{
  ufl(1:3) = 0.d0, 0.0d0, 0.0d0,
  uth(1:3) = 0.d0, 0.0d0, 0.0d0,
}

profile
{
  density = 0.0,
}

spe_bound
{
  type(1:2,1) =   "open", "open",
  type(1:2,2) =   "open", "open",
}

diag_species
{
  ndump_fac = 1,
  reports = "charge",

  ndump_fac_ene = 1,
  ndump_fac_pha = 1,
  ndump_fac_raw = 10,

  ps_xmin(1:2) = 0.0, 0.0,
  ps_xmax(1:2) = 2.0, 2.0,
  ps_nx(1:2)   =  50,  50,

  ps_pmin(1:3) = -1.0, -1.0, -1.0,
  ps_pmax(1:3) =  1.0,  1.0,  1.0,
  ps_np(1:3)   = 2048,  2048,  2048,
  if_ps_p_auto(1:3) = .true., .true., .true.,

  ps_gammamin = 1.0,
  ps_gammamax = 2.0,
  ps_ngamma = 512,
  if_ps_gamma_auto = .true.,

  phasespaces = "p2x1", "p1x1", "p2x2", "p1x2",

  raw_fraction = 1.0,
}