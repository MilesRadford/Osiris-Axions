simulation
{
  algorithm = "qed",
  omega_p0 = 1.8836e15, ! we normalise to the laser wavelength = 1.0 microns
}

node_conf
{
  node_number(1:2) =  2, 2,
  if_periodic(1:2) = .true., .true.,
}


!----------spatial grid----------
grid
{
  nx_p(1:2) = 200, 200,
  coordinates = "cartesian",
}

!----------time step and global data dump timestep number----------
time_step
{
  dt =  0.021,
  ndump =   2,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:2) = -4.0, -4.0,
  xmax(1:2) =  4.0,  4.0,
  if_move(1:2) = .false., .false.,
}

!----------time limits ----------
time
{
  tmin =  0.00,
  tmax =  1.00,
}

el_mag_fld
{
  ext_fld = "static",
  type_ext_b(1:3) = "uniform", "uniform", "uniform",
  ext_b0(1:3) = 0.0, 0.0, 1.432d3,
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

!----------emf diagnostics----------
diag_emf{
  ndump_fac = 1,
  ndump_fac_ene_int = 1,
  reports = "ext_b1",
}

!----------number of particle species----------
particles
{
  num_qed = 1,
  interpolation = "cubic",
}

!----------qed group, setting photon and pair creation----------
qed_group
{
  if_damp_classical = .true.,
  if_damp_qed = .true.,
  if_pairprod = .true.,
  qed_g_cutoff =  100.,
  p_emit_cutoff = 2.0,
}

!----------qed group, setting diagnostics----------
qed_group_diag
{
  ndump_fac_rad = 1,
  ndump_fac_pairs = 1,

  ndump_fac_chi = 2,
  ndump_fac_n_emit = 2,
}

!----------information for electrons----------

species
{
  name = "electrons",
  num_par_x(1:2) = 4, 4,
  num_par_max = 1000000,
  rqm = -1.0,
  push_type="standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) =     0.0, 0.0, 0.0,
  ufl(1:3) = 2.863d3, 0.0, 0.0,
}

profile
{
  density = 1.0,
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports = "charge",

  ps_xmin(1:2) = -4.0, -4.0,
  ps_xmax(1:2) =  4.0,  4.0,
  ps_nx(1:2)   =  200,  200,

  ps_pmin(1:3)   = -1.e-5, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.e-5,  1.e-5,  1.e-5,
  ps_np(1:3)     =    400,    400,    400,
  if_ps_p_auto(1:3) = .true., .true., .true.,

  ps_ngamma   =  1000,
  ps_gammamin = 1.0e-5,
  ps_gammamax = 1.0e-5,
  if_ps_gamma_auto = .true.,

  phasespaces = "p2p1", "g",

  raw_fraction = 1.00,

!  ndump_fac_tracks = 1,
!  niter_tracks = 1,
!  file_tags = "electrons.tags",

}

!----------information for positrons----------

species
{
  name = "positrons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 200000,
  rqm = 1.0,
  push_type="standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports = "charge",

  ps_xmin(1:2) = -4.0, -4.0,
  ps_xmax(1:2) =  4.0,  4.0,
  ps_nx(1:2)   =  200,  200,

  ps_pmin(1:3)   = -1.e-5, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.e-5,  1.e-5,  1.e-5,
  ps_np(1:3)     =    400,    400,    400,
  if_ps_p_auto(1:3) = .true., .true., .true.,

  ps_ngamma   =  1000,
  ps_gammamin = 1.0e-5,
  ps_gammamax = 1.0e-5,
  if_ps_gamma_auto = .true.,

  phasespaces = "p2p1", "g",

  raw_fraction = 0.01,
}

!----------information for photons----------

species
{
  name = "photons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 1500000,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports = "charge",

  ps_xmin(1:2) = -4.0, -4.0,
  ps_xmax(1:2) =  4.0,  4.0,
  ps_nx(1:2)   =  200,  200,

  ps_pmin(1:3)   = -1.e-5, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.e-5,  1.e-5,  1.e-5,
  ps_np(1:3)     =    400,    400,    400,
  if_ps_p_auto(1:3) = .true., .true., .true.,

  ps_ngamma   =  1000,
  ps_gammamin = 1.0e-5,
  ps_gammamax = 1.0e-5,
  if_ps_gamma_auto = .true.,

  phasespaces = "p2p1", "g",

  raw_fraction = 0.01,
}

! --------------------- end of osiris input file ---------------
