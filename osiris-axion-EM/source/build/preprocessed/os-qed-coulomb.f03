contains

   subroutine bh_cs(Z, k, cross_section)

      implicit none
      integer, intent(in) :: Z
      real(p_double), intent(in) :: k
      real(p_double), intent(inout) :: cross_section
      real(p_double) :: log10k
      integer :: i, powers
      real(p_double), dimension(:), allocatable :: table

      log10k = log10(k)
      cross_section = 0.0d0

      ! Select the atomic number
      select case (Z)

       case(13)
         if (k .lt. 4.0d0) then
            table = bh_cs_Z_13_low_ene
         else if ( (k .ge. 4.0d0) .and. (k .le. 2.0d3) ) then
            table = bh_cs_Z_13_mid_ene
         else if (k .ge. 2.0d3) then
            table = bh_cs_Z_13_hig_ene
         endif

       case(29)
         if (k .lt. 4.0d0) then
            table = bh_cs_Z_29_low_ene
         else if ( (k .ge. 4.0d0) .and. (k .le. 2.0d3) ) then
            table = bh_cs_Z_29_mid_ene
         else if (k .ge. 2.0d3) then
            table = bh_cs_Z_29_hig_ene
         endif

       case default
         write(0,*) ""
         write(0,*) "   Error : no Bethe-Heitler pair production for Z = ", Z
         write(0,*) "   Check file qed/os-qed-coulomb.f03 for available Z "
         write(0,*) "   aborting..."
         stop

      end select

      powers = size(table)
      do i = 1,powers
         cross_section = cross_section + table(i) * log10k ** int(i-1)
      end do

      cross_section = 10 ** cross_section

   end subroutine bh_cs

   subroutine bh_cdf(Z, i, cdf)

      implicit none
      integer, intent(in) :: Z, i
      real(p_double), dimension(num_p), intent(inout) :: cdf

      select case (Z)

       case(13)
         cdf = bh_cdf_Z_13(1:num_p,i)

       case(29)
         cdf = bh_cdf_Z_29(1:num_p,i)

       case default
         write(0,*) ""
         write(0,*) "   Error : no Bethe-Heitler pair production for Z = ", Z
         write(0,*) "   Check file qed/os-qed-coulomb.f03 for available Z "
         write(0,*) "   aborting..."
         stop

      end select

   end subroutine bh_cdf

   subroutine bh_proba(Z, k, ni, dt, omega_p, n_p, factor_mult, proba)

      implicit none
      integer, intent(in) :: Z
      real(p_double), intent(in) :: k, ni, dt, omega_p, n_p, factor_mult
      real(p_double), intent(inout) :: proba

      real(p_double) :: total_cs, crit_density, normalization, var !copy
      real(p_double), parameter :: cl = 299792458.0 ! m/s

      ! Normalization
      crit_density = n_p * 1.d6
      normalization = crit_density * cl / omega_p

      ! Cross-section in m^2
      call bh_cs(Z, k, total_cs)

      ! Probabilite of no event
      var = total_cs * ni * dt * normalization

      ! Probability of an event
      proba = factor_mult * (1.0d0 - EXP(-var))

   end subroutine bh_proba

   subroutine bh_spec(Z, k, gam_p)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: k
      real(p_double), intent(inout) :: gam_p
      integer :: i, i1, i2, j, j1, j2
      real(p_double) :: log10k, r, diff, weight
      real(p_double), dimension(num_p) :: cdf1, cdf2, cdf

      ! k is log scaled in the table
      log10k = log10(k)

      ! Interpolate the photon energy k in the table
      if (log10k .le. min_k) then
         i1 = 1
         i2 = 1
         log10k = min_k
      else if (log10k .ge. max_k) then
         i1 = num_k
         i2 = num_k
         log10k = max_k
      else
         i = nint( 1.d0 + (num_k - 1.d0) * ( log10k - min_k ) / ( max_k - min_k ) )
         if (k .gt. axis_k(i)) then
            i1 = i
            i2 = i + 1
         else if (k .lt. axis_k(i)) then
            i1 = i - 1
            i2 = i
         else
            i1 = i
            i2 = i
         endif
      endif

      ! cdf for the two nearest values in the table
      call bh_cdf(Z, i1, cdf1)
      call bh_cdf(Z, i2, cdf2)

      ! Interpolate the cdf for the energy k
      if (i1 .eq. i2) then
         weight = 1.0d0
      else
         weight = ( log10(axis_k(i2)) - log10k ) / ( log10(axis_k(i2)) - log10(axis_k(i1)) )
      endif

      do i = 1,num_p
         cdf(i) = weight * cdf1(i) + (1.0d0 - weight) * cdf2(i)
      end do

      ! Draw the positron energy
      call random_number( r )

      do j = 1,num_p
         diff = r - cdf(j)
         if (diff .lt. 0.0d0) then
            j1 = j - 1
            j2 = j
            exit
         else if (diff .eq. 0.0d0) then
            j1 = j
            j2 = j
            exit
         endif
      end do

      ! Deduce the positron energy form the first photon energy
      if (j1 .eq. j2) then
         weight = 1.0d0
      else
         weight = ( cdf(j2) - r ) / ( cdf(j2) - cdf(j1) )
      endif

      gam_p = weight * axis_p(j1) + (1.0d0 - weight) * axis_p(j2)
      gam_p = 1.0d0 + (k - 2.0d0) * gam_p

   end subroutine bh_spec

   subroutine br_cs(Z, ge, cross_section)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: ge
      real(p_double), intent(inout) :: cross_section
      integer :: i, i1, i2
      real(p_double) :: log10ge, weight, cs1, cs2

      ! ge is log scaled in the table
      log10ge = log10(ge - 1.0d0)

      ! Find the nearest indexes
      if (log10ge .le. min_ge) then
         i1 = 1
         i2 = 1
         log10ge = min_ge
      else if (log10ge .ge. max_ge) then
         i1 = num_ge
         i2 = num_ge
         log10ge = max_ge
      else
         i = nint(1.d0 + (num_ge - 1.d0) * (log10ge - min_ge) / (max_ge - min_ge))
         if ( (ge-1.) .lt. axis_ge(i)) then
            i1 = i - 1
            i2 = i
         else if ( (ge-1.) .gt. axis_ge(i)) then
            i1 = i
            i2 = i + 1
         else
            i1 = i
            i2 = i
         endif
      endif

      ! cs for the nearest indexes in the table
      select case (Z)

       case(13)
         cs1 = br_cs_Z_13(i1)
         cs2 = br_cs_Z_13(i2)

       case(29)
         cs1 = br_cs_Z_29(i1)
         cs2 = br_cs_Z_29(i2)

       case default
         write(0,*) ""
         write(0,*) "   Error : no Bremsstrahlung values for Z = Z"
         write(0,*) "   Check file qed/os-qed-coulomb.f03 for available Z "
         write(0,*) "   aborting..."
         stop

      end select

      ! Interpolate the cs given the nearest indexes
      if (i1 .eq. i2) then
         weight = 1.0d0
      else
         weight = (log10(axis_ge(i2)) - log10ge) / (log10(axis_ge(i2)) - log10(axis_ge(i1)))
      endif

      cross_section = weight * cs1 + (1.0d0 - weight) * cs2

   end subroutine br_cs

   subroutine br_proba(Z, ge, ni, dt, omega_p, n_p, factor_mult, proba)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: ge, ni, dt, omega_p, n_p, factor_mult
      real(p_double), intent(inout) :: proba

      real(p_double) :: total_cs, ve, crit_density, normalization, var, phirad, total_csrad
      real(p_double), parameter :: cl = 299792458.0 ! m/s

      ! Normalization
      crit_density = n_p * 1.d6
      normalization = crit_density * cl / omega_p

      ! velocity
      ve = SQRT(1.0d0 - (1.0d0 / ge ** 2))

      ! Cross-section in m^2
      call br_cs(Z, ge, total_cs)

      ! Probability of an event
      var = total_cs * ni * ve * dt * normalization
      proba = factor_mult * (1.0d0 - EXP(-var))

   end subroutine br_proba

   subroutine br_cdf(Z, i, cdf)

      implicit none

      integer, intent(in) :: Z, i
      real(p_double), dimension(num_gk), intent(inout) :: cdf

      select case (Z)

       case(13)
         cdf = br_cdf_Z_13(1:num_gk,i)

       case(29)
         cdf = br_cdf_Z_29(1:num_gk,i)

       case default
         write(0,*) ""
         write(0,*) "   Error : no Bremsstrahlung pair production for Z = ", Z
         write(0,*) "   Check file qed/os-qed-coulomb.f03 for available Z "
         write(0,*) "   aborting..."
         stop

      end select

   end subroutine br_cdf

   subroutine br_spec(Z, ge, gam_k)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: ge
      real(p_double), intent(inout) :: gam_k

      integer :: i, i1, i2, j, j1, j2

      real(p_double) :: r, diff, log10ge, weight, alpha1, alpha2

      real(p_double), dimension(num_gk) :: cdf1, cdf2, cdf

      ! ge is log scaled in the table
      log10ge = log10(ge - 1.d0)

      ! Find the nearest indexes of ge
      if (log10ge .le. min_ge) then
         i1 = 1
         i2 = 1
         log10ge = min_ge
      else if (log10ge .ge. max_ge) then
         i1 = num_ge
         i2 = num_ge
         log10ge = max_ge
      else
         i = nint(1.d0 + (num_ge - 1.d0) * (log10ge - min_ge) / (max_ge - min_ge))
         if ( (ge-1.) .lt. axis_ge(i)) then
            i1 = i - 1
            i2 = i
         else if ( (ge-1.) .gt. axis_ge(i)) then
            i1 = i
            i2 = i + 1
         else
            i1 = i
            i2 = i
         endif
      endif

      ! cdf for the nearest indexes in the table
      call br_cdf(Z, i1, cdf1)
      call br_cdf(Z, i2, cdf2)

      ! Interpolate the cdf for the energy ge
      if (i1 .eq. i2) then
         weight = 1.0d0
      else
         weight = ( log10(axis_ge(i2)) - log10ge ) / ( log10(axis_ge(i2)) - log10(axis_ge(i1)) )
      endif

      ! Lin and log interpolations lead to the same result
      do i = 1, num_gk
         cdf(i) = weight * cdf1(i) + (1.0d0 - weight) * cdf2(i)
      end do

      ! Draw random cdf
      call random_number( r )

      ! get the indices where r lies
      do j = 1, num_gk
         diff = r - cdf(j)
         if (diff .lt. 0.0d0) then
            j1 = j - 1
            j2 = j
            exit
         else if (diff .eq. 0.0d0) then
            j1 = j
            j2 = j
            exit
         endif
      end do

      if (j1 .eq. j2) then
         weight = 1.0d0
      else
         if (j1 .gt. 1) then
            weight = ( cdf(j2) - r ) / ( cdf(j2) - cdf(j1) )
         else
            j1 = j1 + 1
            j2 = j2 + 1
            weight = ( cdf(j2) - r ) / ( cdf(j2) - cdf(j1) )
         endif
      endif

      ! Interpolation and rescaling
      gam_k = weight * log10(axis_gk_log(j1)) + (1.0 - weight) * log10(axis_gk_log(j2))
      gam_k = 10**gam_k
      gam_k = gam_k * (ge - 1.0d0)

   end subroutine br_spec

end module m_qed_coulomb
