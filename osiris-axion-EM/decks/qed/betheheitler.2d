simulation
{
  algorithm = 'qed',
  omega_p0 = 1.88e15,
}

node_conf
{
  node_number(1:2) =  2, 2,
  if_periodic(1:2) = .true.,.true.,
}

!----------spatial grid----------
grid
{
  nx_p(1:2) = 64, 64,
  coordinates = "cartesian",
}

!----------time step and global data dump timestep number----------
time_step
{
  dt =  0.05,
  ndump =  1,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:2) =   0.0,   0.0,
  xmax(1:2) = 12.56, 12.56,
  if_move(1:2) = .false., .false.,
}

!----------time limits ----------
time
{
  tmin = 0.0,
  tmax = 1.0,
}

el_mag_fld
{
}

!----------boundary conditions for em-fields ----------
emf_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  num_qed = 1,
  interpolation = "cubic",
}

!----------qed group, setting photon and pair creation----------
qed_group
{
  if_damp_classical = .false.,
  if_damp_qed = .false.,
  if_pairprod = .false.,
  qed_g_cutoff =  1.e10,
  p_emit_cutoff = 1.e10,
}

!----------qed group, setting diagnostics----------
qed_group_diag
{
  ndump_fac_rad = 1,
  ndump_fac_pairs = 1,
}

! ----------------------------------------------------------------
! electrons that will be created by Bethe Heitler
! ----------------------------------------------------------------

species
{
  name = "electrons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 2000000,
  rqm = -1.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
	type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 5,
	ndump_fac_ene = 1,
	ndump_fac_raw = 5,
	reports = "charge", 

  raw_fraction = 1.0,
}

! ----------------------------------------------------------------
! positrons that will be created by Bethe Heitler
! ----------------------------------------------------------------

species
{
  name = "positrons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 2000000,
  rqm = 1.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
	type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 5,
	ndump_fac_ene = 1,
	ndump_fac_raw = 5,
	reports = "charge", 

  raw_fraction = 1.0,
}

! ----------------------------------------------------------------
! photons that will create pairs via Bethe Heitler
! ----------------------------------------------------------------

species
{
  name = "photons",
  num_par_x(1:2) = 16, 16,
  num_par_max = 300000,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 200.0, 0.0, 0.0,
}

profile
{
  density = 1.e-4,
}

spe_bound
{
	type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 5,
	ndump_fac_ene = 1,
	ndump_fac_raw = 5,
	reports = "charge", 

  raw_fraction = 1.0,
}

! ----------------------------------------------------------------
! ions from the plasma, lead ionized once Pb^+
! ----------------------------------------------------------------

species
{
  name = "ions",
  num_par_x(1:2) = 4, 4,
  num_par_max = 30000,
  rqm = 3672.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 1.0d2,
}

spe_bound
{
	type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 5,
	ndump_fac_ene = 1,
	ndump_fac_raw = 5,
	reports = "charge", 

  raw_fraction = 1.0,
}

qed_betheheitler
{
  if_betheheitler = .true.,
  Z_ion = 29,
  proba_mult = 1.e5,
  i_ion(1) = 1,
}