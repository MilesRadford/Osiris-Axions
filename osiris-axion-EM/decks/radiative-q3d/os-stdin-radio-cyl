simulation
{
  algorithm = "radiative-q3d",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:2) = 4,1,
  if_periodic(1:2) = .false., .false.,
}

!----------spatial grid----------
grid
{
  nx_p(1:2) = 150, 15,
  coordinates = "cylindrical",
  n_cyl_modes = 0,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt = 0.192,
  ndump = 5,
}

!----------restart information----------
restart
{
  ndump_fac = 0,
  if_restart = .false.,
  if_remold = .true.,
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space
{
  xmin(1:2) =  -300.0 , 0.0,
  xmax(1:2) =  0.0, 150.0,
  if_move= .true., .false.,
}


!----------time limits ----------
time
{
  tmin = 0,
  tmax  = 50.1,
}
el_mag_fld
{
ext_fld = "static",
type_ext_b(1:3) = "uniform", "uniform", "uniform",

! b ext pointing in x hat direction
! ext_b0_re(1,1:3) = 0.0, 1.0, 0.0,
! ext_b0_im(1,1:3) = 0.0, 0.0, -1.0,

! b ext pointing in y hat direction
! ext_b0_re(1,1:3) = 0.0, 0.0, 1.0,
! ext_b0_im(1,1:3) = 0.0, 1.0, 0.0,

! b ext pointing in z hat direction
ext_b0_re(0,1:3) = 1.0, 0.0, 0.0,

! You can also use math functions to specify fields for each mode/component
! type_ext_b(1:3) = "math func", "none", "none",
! ext_b_re_mfunc(0,1) = "x1",
! ext_b_re_mfunc(1,1) = "x1^2",
! ext_b_im_mfunc(1,1) = "x2",
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) = "lindman","lindman",
  type(1:2,2) = "axial", "open",
}

!----------diagnostic for electromagnetic fields----------
diag_emf
{
  ndump_fac = 1,
  reports = "e1_cyl_m","e2_cyl_m","e3_cyl_m","b1_cyl_m","b2_cyl_m","b3_cyl_m",
}

!----------number of particle species----------
particles
{
  num_radiat = 1,
  interpolation = "quadratic",
}


!----------configuration of the plasma electrons----------
species
{
  name = "electrons",
  num_par_max = 100000,
  rqm = -1.0,
  num_par_x(1:2) = 1, 1,
  num_par_theta = 8,
  !free_stream = .true.,
  add_tag = .true.,
}


udist
{
  uth(1:3) =  0.00, 0.00, 0.00,
  ufl(1:3) =  100.0, 0.01, 0.0,
}

profile
{
profile_type(1)="math func",

math_func_expr = "if(((x1>(-160.5) && x1<(-20.5))) ,1,0)",
  density = 1.2d-3,
}


spe_bound
{
  type(1:2,1) = "open", "open",
  type(1:2,2) = "axial", "open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_raw = 1,
  raw_fraction = 0.1,
}


spherical
{
  ! number of cells in each direction (time, theta, phi, r)
  nf(:) = 512,1,64,1,
  ! range of the detector
  dmin(:)=40.5,1.57078,-0.1,100000,
  dmax(:)=120.5,1.67,0.1,100001,
  ! far-far-field approximation
  apprx=.True.,
  ! Output field components
  comps(:)=.False.,.True.,.False.,.False.,.False.,.False.,
  ndump_fac_det=10,
}

current{}

smooth
{
  type(1:2) = "5pass", "none",
}

! --------------------- end of osiris input file ---------------
