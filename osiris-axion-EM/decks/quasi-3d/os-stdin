simulation
{
  algorithm = "quasi-3D",
}

node_conf
{
  node_number(1:2) =  1,1,
  if_periodic(1:2) = .false., .false.,
}


!----------spatial grid----------
grid
{
  nx_p(1:2) = 200, 50,
  coordinates = "cylindrical",
  n_cyl_modes = 1,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt     =   0.07,
  ndump  =   10,
}


!----------spatial limits of the simulations----------
space
{
  xmin(1:2) =     0.0,  0.0,
  xmax(1:2) =   100.0, 10.0,
  if_move(1:2) = .true., .false.,
}


!----------time limits ----------
time
{
  tmin = 0.0,
  tmax  = 7.0,
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) = "lindman","lindman",
  type(1:2,2) = "axial","open",
}


!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation = "quadratic",
}


!----------information for species 1----------

species
{
  name = "positrons",
  num_par_x(1:2) = 1, 3,
  num_par_theta = 8,
  num_par_max = 100000,
  rqm= 1.0,
}

udist
{
  uth(1:3) =  0.01, 0.01, 0.01,
  ufl(1:3) =  0.0, 0.0, 0.0,
}

profile
{
  density = 1.0,
}

spe_bound
{
  type(1:2,1) = "open","open",
  type(1:2,2) = "axial","open",
}

diag_species
{
  ndump_fac = 1,
  ndump_fac_ave = 1,
  ndump_fac_lineout = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  reports =  "charge_cyl_m",

  ps_xmin(1:2) =   0.0,  0.0,
  ps_xmax(1:2) = 100.0, 10.0,
  ps_nx(1:2) = 100, 25,

  ! For xc2 and xc3 phasespaces, which are cartesian x2 and x3
  ps_xcmin(1:3) =   0.0, -10.0, -10.0,
  ps_xcmax(1:3) = 100.0, 10.0, 10.0
  ps_nxc(1:3) = 100, 50, 50,

  ps_pmin(1) = -5,
  ps_pmax(1) = 5,
  ps_np(1) = 125,
  if_ps_p_auto(1) = .true.,
  phasespaces = "p1x2x1", "x1xc2xc3", "p1xc2",

  raw_fraction = 0.02,
}









