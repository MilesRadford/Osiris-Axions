
!--------the node configuration for this simulation--------
simulation
{
	algorithm = 'cuda',
}
node_conf 
{
node_number(1:2) =  1, 1, 
if_periodic(1:2) =  .true., .true., 

n_threads = 1,
}


!----------spatial grid----------
grid 
{
  nx_p(1:2) =  128, 128,
  coordinates = "cartesian",
}


!----------time step and global data dump timestep number----------
time_step 
{
  dt     =   0.07,
  ndump  =   1, 
}



!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space 
{
  xmin(1:2) =  0.0d0, 0.0d0,  
  xmax(1:2) =  12.8d0,  12.8d0,  
  if_move(1:2) = .false.,.false.,
}


!----------time limits ----------
time 
{
  tmin = 0.0d0, tmax  = 0.7d0,
}


!----------boundary conditions for em-fields ----------
emf_bound 
{
}




!----------number of particle species----------
particles 
{ 
  num_species = 1, 
!  interpolation = "linear", 
!  interpolation = "quadratic", 
!  interpolation = "cubic", 
  interpolation = "quartic", 
  
  ndump_fac = 1,
  reports = "charge",
}



!----------information for ELECTRONS----------
species 
{
  name = "electrons",
  num_par_max = 1500000,
  rqm = -1.0d0,
  num_par_x(1:2) = 2, 2,  
  
  ! push_type = "standard",
}

udist
{
  uth(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
  ufl(1:3) = 3000000.0d0 , 3000000.0d0 , 3000000.0d0 ,

}

profile
{
  profile_type = "sphere",
  sphere_center(1:2) = 3.2, 6.4, 
  sphere_radius = 1.4,
}


!----------boundary conditions for this species----------
spe_bound 
{
}

diag_species 
{
  ndump_fac_raw = 1,  
}



diag_current
{
  ndump_fac = 1,
  reports = "j1", "j2", "j3", 
}


