   subroutine ct_spec_pair(Z, gam_1, gam_pa)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: gam_1
      real(p_double), intent(inout) :: gam_pa

      integer :: i, i1, i2, j, j1, j2

      real(p_double) :: r, diff, log10ge, weight, alpha1, alpha2

      real(p_double), dimension(num_gpa_ct) :: cdf1, cdf2, cdf

      ! ge is log scaled in the table
      log10ge = log10(gam_1)

      ! Find the nearest indexes of ge
      if (log10ge .le. min_ge_ct) then
         i1 = 1
         i2 = 1
         log10ge = min_ge_ct
      else if (log10ge .ge. max_ge_ct) then
         i1 = num_ge_ct
         i2 = num_ge_ct
         log10ge = max_ge_ct
      else
         i = nint(1.d0 + (num_ge_ct - 1.d0) * (log10ge - min_ge_ct) / (max_ge_ct - min_ge_ct))
         if ( gam_1 .lt. axis_ge_ct(i)) then
            i1 = i - 1
            i2 = i
         else if ( gam_1 .gt. axis_ge_ct(i)) then
            i1 = i
            i2 = i + 1
         else
            i1 = i
            i2 = i
         endif
      endif

      ! cdf for the nearest indexes in the table
      call ct_cdf(Z, i1, cdf1)
      call ct_cdf(Z, i2, cdf2)

      ! Interpolate the cdf for the energy ge
      if (i1 .eq. i2) then
         weight = 1.0d0
      else
         weight = ( log10(axis_ge_ct(i2)) - log10ge ) / ( log10(axis_ge_ct(i2)) - log10(axis_ge_ct(i1)) )
      endif

      ! Lin and log interpolations lead to the same result
      do i = 1, num_gpa_ct
         cdf(i) = weight * cdf1(i) + (1.0d0 - weight) * cdf2(i)
      end do

      ! Draw random cdf
      call random_number( r )

      ! get the indices where r lies
      do j = 1, num_gpa_ct
         diff = r - cdf(j)
         if (diff .lt. 0.0d0) then
            j1 = j - 1
            j2 = j
            exit
         else if (diff .eq. 0.0d0) then
            j1 = j
            j2 = j
            exit
         endif
      end do

      ! Deduce the pair energy
      if (j1 .eq. j2) then
         weight = 1.0d0
      else
         if (j1 .gt. 1) then
            weight = ( cdf(j2) - r ) / ( cdf(j2) - cdf(j1) )
         else
            j1 = j1 + 1
            j2 = j2 + 1
            weight = ( cdf(j2) - r ) / ( cdf(j2) - cdf(j1) )
         endif
      endif

      ! Interpolation and rescaling
      !gam_pa = weight * log10(axis_gpa_ct(j1)) + (1.0 - weight) * log10(axis_gpa_ct(j2))
      gam_pa = weight * axis_gpa_ct(j1) + (1.0 - weight) * axis_gpa_ct(j2)
!      print *, axis_gpa_ct(j1), gam_pa, axis_gpa_ct(j2)
!      if (gam_pa .lt. 0) then
!         print *, j1, j2, weight, axis_gpa_ct(j1), gam_pa, axis_gpa_ct(j2)
!      endif
      !gam_pa = 10**gam_pa
      gam_pa = 2.0 + gam_pa * (gam_1 - 3.0)

   end subroutine ct_spec_pair

   subroutine ct_spec_posi(Z, gam_1, gam_pa, gam_p)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: gam_1, gam_pa
      real(p_double), intent(inout) :: gam_p

      integer :: i, i1, i2, j, j1, j2, k, k1, k2
      real(p_double) :: x, x1, x2, y, y1, y2, w_11, w_12, w_21, w_22, weight, diff, r
      real(p_double) :: log10ge, log10gpa, min_gpa_ct, max_gpa_ct
      real(p_double), dimension(num_gpa_ct) :: axis_gpa_ct
      real(p_double), dimension(num_gp_ct) :: cdf, cdf_11, cdf_12, cdf_21, cdf_22

      ! Axis for the pair energy as defined in the table
      min_gpa_ct = log10(4.1)
      max_gpa_ct = log10(gam_1 - 1.1)
      do j = 1, num_gpa_ct
         axis_gpa_ct(j) = 10**(log10(4.1) + (log10(gam_1 - 1.1) - log10(4.1)) * (j - 1) / (num_gpa_ct - 1))
      enddo

      ! Interpolate the electron energy (gam_1) in the first axis of the table
      ! the outputs are two integers i1 and i2, the two closest neighbours indexes in the table

      ! ge is log scaled in the table
      log10ge = log10(gam_1)

      ! Find the nearest indexes of ge
      if (log10ge .le. min_ge_ct) then
         i1 = 1
         i2 = 1
         log10ge = min_ge_ct
      else if (log10ge .ge. max_ge_ct) then
         i1 = num_ge_ct
         i2 = num_ge_ct
         log10ge = max_ge_ct
      else
         i = nint(1.d0 + (num_ge_ct - 1.d0) * (log10ge - min_ge_ct) / (max_ge_ct - min_ge_ct))
         if ( gam_1 .lt. axis_ge_ct(i)) then
            i1 = i - 1
            i2 = i
         else if ( gam_1 .gt. axis_ge_ct(i)) then
            i1 = i
            i2 = i + 1
         else
            i1 = i
            i2 = i
         endif
      endif

      ! Interpolate gam_pa in the second axis of the table
      ! the outputs are two integers j1 and j2, the two closest neighbours indexes in the table

      ! gam_pa is log scaled in the table
      log10gpa = log10(gam_pa)

      ! Find the nearest indexes of ge
      if (log10gpa .le. min_gpa_ct) then
         j1 = 1
         j2 = 1
         log10gpa = min_gpa_ct
      else if (log10gpa .ge. max_gpa_ct) then
         j1 = num_gpa_ct
         j2 = num_gpa_ct
         log10gpa = max_gpa_ct
      else
         j = nint(1.d0 + (num_gpa_ct - 1.d0) * (log10gpa - min_gpa_ct) / (max_gpa_ct - min_gpa_ct))
         if ( gam_pa .lt. axis_gpa_ct(j)) then
            j1 = j - 1
            j2 = j
         else if ( gam_pa .gt. axis_gpa_ct(j)) then
            j1 = j
            j2 = j + 1
         else
            j1 = j
            j2 = j
         endif
      endif

      ! From these indexes, we get the CDF of the 4 closest neighbours
      !call ct_cdf_double(Z, i1, j1, cdf_11)
      !call ct_cdf_double(Z, i1, j2, cdf_12)
      !call ct_cdf_double(Z, i2, j1, cdf_21)
      !call ct_cdf_double(Z, i2, j2, cdf_22)

      ! We do a 1st order lin-lin interpolation
      ! We may try a 1st order log-log interpolation

      ! We introduce notations to make it easier
      x = gam_1
      x1 = axis_ge_ct(i1)
      x2 = axis_ge_ct(i2)
      y = gam_pa
      y1 = axis_gpa_ct(j1)
      y2 = axis_gpa_ct(j2)

      ! weights of the interpolation
      if ((i1 .ne. i2) .and. (j1 .ne. j2)) then
         w_11 = (x2 - x) * (y2 - y) / ((x2 - x1) * (y2 - y1))
         w_12 = (x2 - x) * (y - y1) / ((x2 - x1) * (y2 - y1))
         w_21 = (x - x1) * (y2 - y) / ((x2 - x1) * (y2 - y1))
         w_22 = (x - x1) * (y - y1) / ((x2 - x1) * (y2 - y1))
      else if ((i1 .eq. i2) .and. (j1 .ne. j2)) then
         w_11 = (y2 - y) / (y2 - y1)
         w_12 = 1.0 - w_11
         w_21 = 0.0
         w_22 = 0.0
      else if ((j1 .eq. j2) .and. (i1 .ne. i2)) then
         w_11 = (x2 - x) / (x2 - x1)
         w_12 = 0.0
         w_21 = 1.0 - w_11
         w_22 = 0.0
      else if ((i1 .eq. i2) .and. (j1 .eq. j2)) then
         w_11 = 1.0
         w_12 = 0.0
         w_21 = 0.0
         w_22 = 0.0
      end if

      ! Perform the interpolation
      do k = 1, num_gp_ct
         cdf(k) = w_11 * cdf_11(k) + w_12 * cdf_12(k) + w_21 * cdf_21(k) + w_22 * cdf_22(k)
      end do

      ! We draw a random number and interpolate it in the CDF
      call random_number( r )
      do k = 1, num_gp_ct
         diff = r - cdf(k)
         if (diff .lt. 0.0d0) then
            k1 = k - 1
            k2 = k
            exit
         else if (diff .eq. 0.0d0) then
            k1 = k
            k2 = k
            exit
         endif
      end do

      ! Deduce the positron energy
      if (k1 .eq. k2) then
         weight = 1.0d0
      else
         weight = ( cdf(k2) - r ) / ( cdf(k2) - cdf(k1) )
      endif

      ! Interpolation and rescaling
      gam_p = weight * axis_gp_ct(k1) + (1.0 - weight) * axis_gp_ct(k2)
      gam_p = 1.0 + gam_p * (gam_pa - 2.0)

      end subroutine ct_spec_posi

   subroutine ct_spec_posi_general(Z, gam_1, gam_pa, gam_p)

      implicit none

      integer, intent(in) :: Z
      real(p_double), intent(in) :: gam_1, gam_pa
      real(p_double), intent(inout) :: gam_p
      real(p_double), dimension(num_gp_ct) :: cdf
      real(p_double) :: diff, r, weight
      integer :: k, k1, k2

      call ct_cdf_double(Z, cdf)

      ! We draw a random number and interpolate it in the CDF
      call random_number( r )
      do k = 1, num_gp_ct
         diff = r - cdf(k)
         if (diff .lt. 0.0d0) then
            k1 = k - 1
            k2 = k
            exit
         else if (diff .eq. 0.0d0) then
            k1 = k
            k2 = k
            exit
         endif
      end do

      ! Deduce the positron energy
      if (k1 .eq. k2) then
         weight = 1.0d0
      else
         weight = ( cdf(k2) - r ) / ( cdf(k2) - cdf(k1) )
      endif

      ! Interpolation and rescaling
      gam_p = weight * axis_gp_ct(k1) + (1.0 - weight) * axis_gp_ct(k2)
      gam_p = 1.0 + gam_p * (gam_pa - 2.0)

   end subroutine ct_spec_posi_general

end module m_qed_coulomb
