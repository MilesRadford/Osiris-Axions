simulation
{
  algorithm = "quasi-3D",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:2) = 1, 1,
  if_periodic(1:2) = .false., .false.,
}

!----------spatial grid----------
grid
{
  nx_p(1:2) = 1024,640,
  coordinates = "cylindrical",
  n_cyl_modes = 4,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt= 0.00390625,
  ndump  =  2560,
}

!----------restart information----------
restart
{
  ndump_fac = 0,
  if_restart = .false.,
  if_remold = .true.,
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space
{
  xmin(1:2) = -14, 0,
  xmax(1:2) =   2,  12.0,
  if_move = .true., .false.,
}


!----------time limits ----------
time
{
  tmin = 0.0,
  tmax = 300.0,
}

el_mag_fld
{
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) =  "lindman", "lindman",
  type(1:2,2) =  "axial", "open",
}

!----------diagnostic for electromagnetic fields----------
diag_emf
{
  ndump_fac = 1,
  reports = "e1_cyl_m","e2_cyl_m","b3_cyl_m",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation =  "quadratic",
}

!----------configuration of the bunch----------
species
{
  name = "driver",
  num_par_max = 800000,
  rqm=-1.0,
  num_par_x(1:2) = 1, 1,
  num_par_theta = 32,
}

udist
{
  use_classical_uadd = .true.,
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 20000.0 , 0.0 , 0.0,
  n_accelerate = 512,
}

profile
{
  den_min = 1.d-5,
  ! sigmax3/sigmax2 = 0.8
  aspect_ratio = 0.8,

  density = 150, !
  profile_type(1:2) = "gaussian", "gaussian",
  gauss_center(1:2) = -2.1, 0.0,
  gauss_sigma(1:2) = 0.7, 0.5,
  gauss_range(1:2,1) = -5.9,1.7,
  gauss_range(1:2,2) = -2.0, 2.0,
}

spe_bound
{
  type(1:2,1) = "open", "open",
  type(1:2,2) = "axial", "open",
}

diag_species
{
  ndump_fac = 1,
  reports = "charge_cyl_m",
  ndump_fac_raw=1,
  raw_fraction=1,
}

current{}

smooth
{
  type(1:2) = "5pass", "none",
}

diag_current
{
  ndump_fac = 1,
  reports = "j1_cyl_m",
}
! --------------------- end of osiris input file ---------------

