simulation
{
  algorithm = "quasi-3D",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:2) = 1,1,
  if_periodic(1:2) = .false., .false.,
}

!----------spatial grid----------
grid
{
  nx_p(1:2) = 150, 25,
  coordinates = "cylindrical",
  n_cyl_modes = 1,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt = 0.192,
  ndump = 52,
}

!----------restart information----------
restart
{
  ndump_fac = 0,
  if_restart = .false.,
  if_remold = .true.,
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space
{
  xmin(1:2) =  -300.0 , 0.0,
  xmax(1:2) =  0.0, 250.0,
  if_move= .true., .false.,
}


!----------time limits ----------
time
{
  tmin = 0,
  tmax  = 101,
}
el_mag_fld
{
}

!----------boundary conditions for em-fields ----------
emf_bound
{
  type(1:2,1) = "lindman","lindman",
  type(1:2,2) = "axial", "open",
}

!----------diagnostic for electromagnetic fields----------
diag_emf
{
  ndump_fac = 1,
  reports = "e1_cyl_m","e2_cyl_m","e3_cyl_m","b1_cyl_m","b2_cyl_m","b3_cyl_m",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation = "quadratic",
}


!----------configuration of the plasma electrons----------
species
{
  name = "electrons",
  num_par_max = 100000,
  rqm = -1.0,
  num_par_x(1:2) = 1, 1,
  num_par_theta = 8,
  free_stream = .true.,
  add_tag = .true.,
}

profile
{
  density = 1.2d-3,
}

spe_bound
{
  type(1:2,1) = "open", "open",
  type(1:2,2) = "axial", "open",
}

diag_species
{
  ndump_fac = 1,
  reports = "charge_cyl_m",
  ndump_fac_raw = 1,
  raw_fraction = 0.01,
  ndump_fac_tracks = 1,
  ifdmp_tracks_efl(1:3) = .true., .true., .true.,
  ifdmp_tracks_bfl(1:3) = .true., .true., .true.,
  niter_tracks = 1,
  file_tags = "electrons.tags",
}


zpulse
{
  a0 = 2,
  omega0 = 1.0,
  pol_type = 0,
  pol = 0.0,

  propagation = "forward",
  lon_type = "gaussian",
  lon_start = 1.0,
  lon_x0 = -110,
  lon_duration = 75,
  lon_range = 200,
  per_type = "gaussian",
  per_w0 = 110, ! 14um
  per_focus = 0.0,
  per_center = 0.0,0.0,
}

current{}

smooth
{
  type(1:2) = "5pass", "none",
}

! --------------------- end of osiris input file ---------------

