!----------global simulation parameters----------
simulation 
{
}
!--------the node configuration for this simulation--------
node_conf 
{
 node_number(1:1) = 10,
 if_periodic(1:1) = .false.,
}

!----------spatial grid----------
grid 
{
  nx_p(1:1) =  2500,
  coordinates = "cartesian",
}

!----------time step and global data dump timestep number----------
time_step 
{
  dt     =  0.038,
  ndump  =  1, 
}

!----------restart information----------
restart 
{
  ndump_fac = 0,
  if_restart=.false.,
}

!----------spatial limits of the simulations----------
space 
{
  xmin(1:1) =  0.000d0 ,
  xmax(1:1) =   100. ,
  if_move(1:1)= .true.,
  !move_u = 2.0,
}

!----------time limits ----------
time 
{
  tmin = 0.0d0, tmax  = 110.0,
}

!----------field solver set up----------

el_mag_fld 
{
  smooth_type = "none",
  ext_fld = "none",
}



!----------boundary conditions for em-fields ----------
emf_bound 
{
  type(1:2,1) =   "open", "open",
  !vpml_bnd_size = 4,
}

!----------em-field diagnostics---------------
diag_emf
  {
    ndump_fac = 1,
    ndump_fac_ene_int = 1,
    reports = "e1", "e3",
  }

!----------number of particle species----------
particles 
{ 
  num_cathode = 0,
  num_species = 1,
  interpolation = "cubic",
}
!cathode
!{
!  wall = 2,
!  mov_inj = .true.,
!  t_rise = 250.,
!  t_flat = 100.,
!  t_fall = 100.,
!  den_min = 1.e-5,
!
!}
!----------information for ELECTRONS ----------
species 
{
  name = "electrons",
  num_par_max = 200000,
  rqm=-1.0,
  num_par_x(1:1) = 2000,
  !den_min = 1.d-5,
  !add_tag = .true.,
}

!----------information for species ELECTRONS ----------
udist 
{
  use_zpulse_equilibrium = .true.,
  uth(1:3) = 0.001, 0.001, 0.001,
  ufl(1:3) = 0.0, 0.00, 0.00,
}

profile 
{
  !profile_type(1:1) = "math func",
  density = 0.05,
  !math_func_expr="if(x1<100.0,1e-5,if(x1<120.0,0.05*sin(1.571*(x1-100.0)/20.0)^2,if(x1<180.0,0.05,if(x1<200.0,0.05*sin(1.571*(220.0-x1)/20.0)^2,1e-5))))", 
}

!----------boundary conditions for this species----------
spe_bound 
{
  type(1:2,1) =     "open",    "open",
}

!----------diagnostic for this species----------
diag_species 
{
 ndump_fac = 1, 
 reports = "charge",

 ndump_fac_ene = 1,
 ndump_fac_pha = 1, 
 ndump_fac_raw = 0,
 ps_xmin(1) =  0.0,
 ps_xmax(1) =  100.,
 ps_nx(1)   =  2500,

 ps_pmin(1:3) = -0.1, -0.1, -0.1,
 ps_pmax(1:3) = 0.1,  0.1,  0.1,
 ps_np(1:3)   = 255,  255,  512,
 if_ps_p_auto(1:3) = .true., .true., .true., 
  
 ps_gammamin = 1.0, 
 ps_gammamax = 2.0,
 ps_ngamma = 512,
 if_ps_gamma_auto = .true.,
     
 phasespaces = "x1_m", "p3x1_m", "p2x1_m",
 raw_gamma_limit = 0.0,

 raw_fraction = 1.0,
 raw_math_expr = "1.0",
 
 
! ndump_fac_tracks = 100,
! niter_tracks = 1,
! file_tags = "electron.tags",
}

!zpulse 
!{
!  direction = 1,
!  propagation = "forward",   ! launch the pulse with forward propagation (default)
!  
!  a0 = 0.269869,                  ! use a normalized peak value of 1
!  omega0 = 0.998984,            ! use a normalized central frequency of 5.0
!  pol = 90.0d0,              ! use a 45 deg polarization angle
!  
!  
!  lon_type = "polynomial",   ! use a polynomial longitudinal envelope
!  lon_rise = 150,            ! use a 6.4 1/wp rise time
!  lon_flat = 0.0,            ! hold the peak value for 0.0 length (i.e. don't hold it)
!  lon_fall = 150,            ! use a 6.4 1/wp fall time. The pulse will have a total length of 12.8
!  lon_start = 385,dddd
!
!  per_type = "gaussian",     ! use a gaussian transverse profile
!  per_focus = 3385,
!  per_w0 = 138,
!  
!}

zpulse_mov_wall 
{
  !direction = 1,
  propagation = "backward",   ! launch the pulse with forward propagation (default)

  launch_time = 0.0,
  
  a0 = 0.0853402,          ! use a normalized peak value of 1
  omega0 = 1.0,            ! use a normalized central frequency of 5.0
  k0 = 0.974679,		   ! wave number consistent with the plasma dispersion relation
  pol = 90.0d0,              ! use a 45 deg polarization angle
  wall_pos=100.,  
  wall_vel=1.0,!0.894427,!0.995037,!
  tenv_type = "sin2",   ! use a polynomial longitudinal envelope
  tenv_rise = 20.,            ! use a 6.4 1/wp rise time
  tenv_flat = 80.,            ! hold the peak value for 0.0 length (i.e. don't hold it)
  tenv_fall = 20.0,            ! use a 6.4 1/wp fall time. The pulse will have a total length of 12.8
  !if_add_fields=.true.,
  if_launch_from_wall = .true.,
  !interpolation="quadratic",
  xi0=0.,
!  per_type = "gaussian",     ! use a gaussian transverse profile
!  per_focus = 3385,
!  per_w0 = 200,
}

!----------smoothing for currents----------
smooth
{
  type(1) = "compensated",! "compensated",
}

!----------diagnostic for currents---------- 
diag_phy_field 
{
}

!-----------diagnostic for charge-----------
diag_phy_field 
{
}
