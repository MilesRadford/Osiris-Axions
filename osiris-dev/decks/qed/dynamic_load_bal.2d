simulation
{
  algorithm = 'qed',
  omega_p0 = 1.88e15,
}

node_conf
{
  node_number(1:2) =  4, 1,
  if_periodic(1:2) = .true., .true.,
}


!----------spatial grid----------
grid
{
  nx_p(1:2) = 200, 200,
  coordinates = "cartesian",

  ndump_node_load = 4,

  load_balance = .true.,.true.,
  lb_type = "dynamic",
  n_dynamic = 4,
  cell_weight = 0.7,
  start_load_balance = 1,
  balance_on_start = .true.,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt =  0.02,
  ndump =  4,
}

!----------spatial limits of the simulations----------
space
{
  xmin(1:2) = -4.0, -4.0,
  xmax(1:2) =  4.0,  4.0,
  if_move(1:2) = .false., .false.,
}

!----------time limits ----------
time
{
  tmin =  0.00,
  tmax =  0.40,
}

el_mag_fld
{
  ext_fld = "static",
  type_ext_b(1:3) = "uniform", "uniform", "uniform",
  ext_b0(1:3) = 1.05e3, 0.0, 0.0,
}


!----------boundary conditions for em-fields ----------
emf_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

!----------emf diagnostics----------
diag_emf{
  ndump_fac = 1,
  ndump_fac_ene_int = 1,
  reports = "ext_b1", 
}

!----------number of particle species----------
particles
{
  num_species = 1,
  num_qed = 1,
  interpolation = "cubic",
  dlb_fld2_thresh = 10000.,
  dlb_part_weight = 2.0,
}

!----------qed group, setting photon and pair creation----------
qed_group
{
  if_damp_classical = .false.,
  if_damp_qed = .true.,
  if_pairprod = .true.,
  qed_g_cutoff =  0.,
  p_emit_cutoff = 0.,
}

!----------qed group, setting diagnostics----------
qed_group_diag
{
  ndump_fac_rad = 1,
  ndump_fac_pairs = 1,
  ndump_fac_pairs_from_elec = 1,
  ndump_fac_radspect = 1,
  ndump_fac_chi_emit = 1,
  ndump_fac_chi = 1,
  ndump_fac_n_emit = 1,
}

!----------information for electrons----------

species
{
  name = "electrons",
  num_par_x(1:2) = 10, 10,
  num_par_max = 5000000,
  rqm = -1.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 1957.,
}

profile
{
  density = 1.0d-6,
  profile_type(1:2) = "math func",
  math_func_expr = "if( x1>0, if(x2>0, 1.0, 0.0), 0.0)",
}

spe_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

!----------information for positrons----------

species
{
  name = "positrons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 5000000,
  rqm = 1.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

!----------information for photons----------

species
{
  name = "photons",
  num_par_x(1:2) = 1, 1,
  num_par_max = 5000000,
  rqm = 0.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) = 0.0, 0.0, 0.0,
  ufl(1:3) = 0.0, 0.0, 0.0,
}

profile
{
  density = 0.0,
}

spe_bound
{
	type(1:2,1) = "open","open",
	type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

! ----------------------------------------------------------------
! ions
! ----------------------------------------------------------------

species
{
  name = "ions",
  num_par_x(1:2) = 4, 4,
  num_par_max = 5000000,
  rqm = 3672.0,
  push_type = "standard",
  add_tag = .true.,
}

udist
{
  uth(1:3) =  0.0, 0.0, 0.0,
  ufl(1:3) =  0.0, 0.0, 0.0,
}

profile
{
  density = 1.0d2,
}

spe_bound
{
	type(1:2,1) = "open","open",
  type(1:2,2) = "open","open",
}

diag_species
{
	ndump_fac = 1,
	ndump_fac_ene = 1,
	reports = "charge", 
  
	ndump_fac_pha = 1,
  ps_ngamma   =  400,
  if_ps_gamma_auto = .true.,
  phasespaces = "g_|charge|",

	ndump_fac_raw = 1,
	raw_fraction = 1.00,
}

qed_bremsstrahlung
{
  if_bremsstrahlung = .true.,
  Z_ion = 29,
  proba_mult = 1.e5,
  energy_damp = .true.,
  i_ion(1) = 1,
}

qed_betheheitler
{
  if_betheheitler = .true.,
  Z_ion = 29,
  proba_mult = 1.e5,
  i_ion(1) = 1,
}

qed_trident_coul
{
  if_trident_coul = .true.,
  Z_ion = 29,
  proba_mult = 1.e7,
  i_ion(1) = 1,
}

! --------------------- end of osiris input file ---------------
